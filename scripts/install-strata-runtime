#!/usr/bin/env python3
"""Install or verify the Strata engine for Qwen 3.8 Flash Next.

Strata runs a 125B MoE on consumer GPUs via expert tiering:
  hot experts on GPU, all experts in RAM, n-gram table on SSD.
  Requires 12+ GB VRAM and 64+ GB system RAM.

This installer:
  1. Clones Niko1221/Strata at the pinned revision
  2. Creates a venv and installs the Python dependencies
  3. Verifies the CUDA toolkit is available
  4. Reports the install status as JSON

Usage:
    python3 scripts/install-strata-runtime [--check-only]
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

RUNTIME_ROOT = Path.home() / ".local/share/turbofit/runtimes"
STRATA_DIR = RUNTIME_ROOT / "strata"
STRATA_REPO = "https://github.com/Niko1221/Strata.git"
STRATA_REVISION = "main"
STRATA_VENV = STRATA_DIR / ".venv"


def run(cmd: list[str], *, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=cwd, check=check, capture_output=True, text=True)


def detect_backend() -> str:
    explicit = os.getenv("TURBOFIT_ACCELERATOR_BACKEND", "").lower()
    if explicit in ("cuda", "hip", "sycl"):
        return explicit
    if shutil.which("nvidia-smi"):
        return "cuda"
    if shutil.which("rocm-smi") or shutil.which("amd-smi"):
        return "hip"
    return "unknown"


def check_cuda() -> dict:
    """Verify CUDA toolkit availability."""
    nvcc = shutil.which("nvcc")
    if not nvcc:
        # Check common install locations
        for candidate in ("/usr/local/cuda/bin/nvcc", "/opt/cuda/bin/nvcc"):
            if Path(candidate).is_file():
                nvcc = candidate
                break
    if not nvcc:
        return {"available": False, "hint": "Install CUDA toolkit 12.0+ (https://developer.nvidia.com/cuda-downloads)"}
    version_out = run([nvcc, "--version"], check=False)
    version = ""
    for line in (version_out.stdout or "").splitlines():
        if "release" in line.lower():
            version = line.strip()
            break
    return {"available": True, "path": nvcc, "version": version}


def install(*, check_only: bool = False) -> dict:
    backend = detect_backend()
    cuda = check_cuda()

    result = {
        "id": "strata",
        "backend": backend,
        "source_dir": str(STRATA_DIR),
        "venv": str(STRATA_VENV),
        "cuda": cuda,
    }

    if backend != "cuda":
        result["status"] = "unsupported-backend"
        result["reason"] = f"Strata requires CUDA, detected: {backend}"
        return result

    if not cuda["available"]:
        result["status"] = "missing-cuda"
        result["reason"] = cuda["hint"]
        return result

    # Check if already installed
    if STRATA_VENV.is_dir() and (STRATA_VENV / "bin" / "python").is_file():
        result["status"] = "already-installed"
        # Verify the venv has the required packages
        pip_check = run(
            [str(STRATA_VENV / "bin" / "pip"), "list"],
            check=False,
        )
        installed_pkgs = (pip_check.stdout or "").lower()
        has_deps = "numpy" in installed_pkgs and "psutil" in installed_pkgs
        result["dependencies_ok"] = has_deps
        return result

    if check_only:
        result["status"] = "not-installed"
        return result

    # Clone
    RUNTIME_ROOT.mkdir(parents=True, exist_ok=True)
    if not (STRATA_DIR / ".git").is_dir():
        run(["git", "clone", STRATA_REPO, str(STRATA_DIR)])
    else:
        run(["git", "-C", str(STRATA_DIR), "fetch", "origin"])
        run(["git", "-C", str(STRATA_DIR), "checkout", STRATA_REVISION])

    # Create venv
    run([sys.executable, "-m", "venv", str(STRATA_VENV)])

    # Install dependencies
    pip = str(STRATA_VENV / "bin" / "pip")
    run([pip, "install", "--upgrade", "pip", "setuptools", "wheel"])
    run([pip, "install", "numpy", "psutil", "requests", "pyyaml", "tqdm"])

    result["status"] = "installed"
    result["dependencies_ok"] = True
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check-only", action="store_true", help="Check status without installing")
    args = parser.parse_args()
    result = install(check_only=args.check_only)
    print(json.dumps(result, indent=2))
    return 0 if result["status"] in ("installed", "already-installed") else 1


if __name__ == "__main__":
    raise SystemExit(main())
