#!/usr/bin/env python3
"""Turbofit adaptive controller daemon for pinned native runtimes."""
from __future__ import annotations

import argparse
from contextlib import nullcontext
import json
import math
import os
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src"
if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

from turbofit_runtime.hardware import probe_hardware  # noqa: E402
from turbofit_runtime.native_backend import NativeRuntimeBackend  # noqa: E402
from turbofit_runtime.native_lifecycle import IdleLifecycle, LifecycleEndpoint  # noqa: E402
from turbofit_runtime.pressure_probe import probe_accelerator_pressure  # noqa: E402
from turbofit_runtime.recipes import RecipeBook  # noqa: E402
from turbofit_runtime.routes import load_runtime_resolutions_many  # noqa: E402
from turbofit_runtime.runtime_service import RuntimeService  # noqa: E402
from turbofit_runtime.selection import ProfileCatalog  # noqa: E402


CONFIG_DIR = Path.home() / ".config" / "turbofit"


def supported_profiles(config_dir=CONFIG_DIR) -> tuple[Path, ...]:
    paths = list(sorted((ROOT / "runtime-profiles").glob("*gb.yaml")))
    manual = config_dir / "manual-profile.yaml"
    if manual.is_file():
        paths.append(manual)
    return tuple(paths)


def build_runtime(args: argparse.Namespace) -> RuntimeService:
    config_dir = getattr(args, "config_dir", CONFIG_DIR)
    catalog = ProfileCatalog.from_paths(supported_profiles(config_dir))
    resolutions = load_runtime_resolutions_many((
        ROOT / "runtime-profiles" / "runtime-resolutions.json",
        config_dir / "manual-runtime-resolutions.json",
    ))
    policy_path = ROOT / "references/catalog-campaign-policy.json"
    policy = json.loads(policy_path.read_text(encoding="utf-8")) if policy_path.is_file() else {}
    deferred = {
        str(model_id) for model_id in policy.get("deferred_models", [])
        if isinstance(model_id, str) and model_id
    }
    catalog = catalog.without_deferred_models(resolutions, deferred)
    hardware = probe_hardware()
    recipe_book = RecipeBook.load(
        getattr(args, "recipes", ROOT / "references" / "model-recipes.json"), hardware=hardware,
    )

    def backend_factory(profile, state):
        return NativeRuntimeBackend(
            profile=profile,
            resolutions=resolutions,
            recipe_book=recipe_book,
            route_state_path=args.routes,
            state_dir=args.runtime_state_dir,
            manager_port=args.manager_port,
            current_state=state,
            accelerator_backend=recipe_book.backend_name,
            verification_timeout_s=args.verification_timeout,
        )

    return RuntimeService(
        catalog=catalog,
        resolutions=resolutions,
        requirements_path=(
            ROOT / "runtime-profiles" / "rung-requirements.json",
            config_dir / "manual-rung-requirements.json",
        ),
        controller_state_path=args.state,
        route_state_path=args.routes,
        manager_port=args.manager_port,
        backend_factory=backend_factory,
    )


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--once", action="store_true", help="run one bounded controller tick")
    parser.add_argument("--interval", type=float, default=2.0)
    parser.add_argument("--manager-port", type=int, default=8092)
    parser.add_argument("--verification-timeout", type=float, default=900.0)
    parser.add_argument("--idle-release", type=float, default=0.0,
                        help="opt-in idle release seconds; 0 preserves always-resident policy")
    parser.add_argument("--config-dir", type=Path, default=CONFIG_DIR)
    parser.add_argument("--recipes", type=Path, default=ROOT / "references/model-recipes.json")
    parser.add_argument(
        "--selection",
        type=Path,
        default=Path(os.getenv("TURBOFIT_SELECTION_STATE", Path.home() / ".config/turbofit/selection.json")),
    )
    parser.add_argument(
        "--state",
        type=Path,
        default=Path(os.getenv("TURBOFIT_CONTROLLER_STATE", Path.home() / ".local/state/turbofit/controller.json")),
    )
    parser.add_argument(
        "--routes",
        type=Path,
        default=Path(os.getenv("TURBOFIT_RUNTIME_STATE", Path.home() / ".local/state/turbofit/runtime-state.json")),
    )
    parser.add_argument(
        "--runtime-state-dir",
        type=Path,
        default=Path(os.getenv("TURBOFIT_NATIVE_STATE", Path.home() / ".local/state/turbofit/native")),
    )
    args = parser.parse_args(argv)
    if args.interval <= 0:
        parser.error("--interval must be positive")
    if args.verification_timeout <= 0:
        parser.error("--verification-timeout must be positive")
    if not math.isfinite(args.idle_release) or args.idle_release < 0:
        parser.error("--idle-release must be finite and non-negative")
    if args.idle_release and args.once:
        parser.error("--idle-release requires a persistent controller, not --once")
    return args


def _owned_status(state_dir: Path) -> dict:
    residents = []
    for role in ("main", "aux"):
        try:
            value = json.loads((state_dir / f"{role}.json").read_text(encoding="utf-8"))
            pid = int(value["pid"])
        except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError):
            continue
        if pid > 0:
            residents.append({"pid": pid, "role": role})
    return {"residents": residents}


def run_tick(runtime, args, lifecycle=None):
    guard = lifecycle.controller_tick() if lifecycle else nullcontext(True)
    with guard as allowed:
        if not allowed:
            return None
        hardware = probe_hardware()
        controller = runtime.synchronize(args.selection, hardware)
        idle_roles = lifecycle.idle_roles() if lifecycle else ()
        if set(idle_roles) == {"main", "aux"}:
            # Idle is intentional, not a failed runtime for the repair loop to
            # resurrect. The next request uses the last verified configuration.
            runtime.release_idle_residency(lifecycle)
            return None
        current = controller.state.adaptive.current_index
        required = controller.requirements.required_mb_by_rung[current]
        pressure = probe_accelerator_pressure(
            hardware, manager_status=_owned_status(args.runtime_state_dir),
            managed_required_mb=required,
        )
        result = runtime.tick(pressure, now=time.monotonic(), restore_current=not idle_roles)
        if lifecycle:
            runtime.release_idle_residency(lifecycle)
        return result


def main(argv: list[str]) -> int:
    args = parse_args(argv[1:])
    runtime = build_runtime(args)
    lifecycle = endpoint = None
    if args.idle_release:
        lifecycle = IdleLifecycle(state_dir=args.runtime_state_dir,
                                  idle_timeout_s=args.idle_release,
                                  wake_timeout_s=args.verification_timeout)
        lifecycle.acquire_singleton()
    try:
        if lifecycle:
            endpoint = LifecycleEndpoint(lifecycle, ensure_ready=runtime.ensure_residency,
                                         resolve_role=runtime.residency_role)
            endpoint.start()
        while True:
            try:
                result = run_tick(runtime, args, lifecycle)
                if result is not None:
                    print(json.dumps({
                        "profile_id": result.state.profile_id,
                        "mode": result.state.selection_mode.value,
                        "rung_index": result.state.adaptive.current_index,
                        "action": result.action.value,
                        "transitioned": result.transitioned,
                        "reason": result.reason,
                    }, sort_keys=True), flush=True)
            except Exception as exc:
                print(json.dumps({"error": str(exc)}, sort_keys=True), file=sys.stderr, flush=True)
                if args.once:
                    return 1
            if args.once:
                return 0
            time.sleep(args.interval)
    finally:
        if endpoint:
            endpoint.stop()
        if lifecycle:
            lifecycle.release_singleton()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
